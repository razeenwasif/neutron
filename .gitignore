/target
target/
**/*.rs.bk
*.pdb

# Windows-side target dir used by xtask
.neutron-target/

# Local secrets: Google Drive OAuth client, etc.
# The client id is supplied through NEUTRON_GOOGLE_CLIENT_ID, never committed —
# see the Google Drive section of the README.
.env
secrets.toml

# WSL surfaces NTFS alternate data streams as separate files. These appear
# beside anything downloaded on the Windows side and are pure noise.
*:Zone.Identifier
